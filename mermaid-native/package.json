{
  "name": "mermaid-native",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Free Atlassian Forge app that renders editable Mermaid diagrams natively in a Jira issue panel — $0/month, no external services.",
  "keywords": [
    "jira",
    "atlassian-forge",
    "mermaid",
    "mermaid-js",
    "diagram",
    "flowchart",
    "sequence-diagram",
    "jira-plugin",
    "jira-app",
    "issue-panel"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --prefix static/main-custom-ui",
    "postinstall": "npm install --prefix static/main-custom-ui",
    "test": "node --test"
  },
  "dependencies": {
    "@forge/api": "^4.0.0",
    "@forge/resolver": "^1.6.0"
  },
  "devDependencies": {
    "@forge/cli": "^13.0.0"
  }
}
